{
  "nodes": [
    {
      "name": "render",
      "type": "DashcamRenderNode",
      "options": {
        "background": "src/examples/assets/dashcam_road.png",
        "car": "src/examples/assets/flydog.png",
        "font": "src/examples/assets/Roboto-Regular.ttf",
        "width": 1280,
        "height": 720,
        "fps": 30,
        "frame_count": 300,
        "format": "%Y-%m-%d %H:%M:%S"
      },
      "output_streams": ["output:frames"]
    },
    {
      "name": "encoder",
      "type": "VideoEncoderNode",
      "options": {
        "fps": 30,
        "bitrate": 4000000
      },
      "input_streams": ["input:frames"],
      "output_streams": ["output:es_packets"]
    },
    {
      "name": "recorder",
      "type": "RecorderNode",
      "input_streams": ["input:es_packets"],
      "output_streams": ["output:clips"]
    },
    {
      "name": "muxer",
      "type": "MuxerSinkNode",
      "options": {
        "output": "out/dashcam.mp4",
        "width": 1280,
        "height": 720,
        "fps": 30
      },
      "input_streams": ["input:clips"]
    },
    {
      "name": "push",
      "type": "StreamPushNode",
      "options": {
        "backend_type": "webrtc",
        "remote_url": "http://127.0.0.1:8889/test/whip",
        "video_codec": "h264",
        "audio_codec": "aac",
        "initial_bitrate_kbps": 2000,
        "max_bitrate_kbps": 5000,
        "min_bitrate_kbps": 200,
        "resolution_width": 1280,
        "resolution_height": 720,
        "framerate": 30,
        "buffer_duration_s": 30,
        "reconnect_max_interval_s": 30
      },
      "input_streams": ["input:es_packets"]
    }
  ]
}
