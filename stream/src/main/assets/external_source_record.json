{
  "nodes": [
    {
      "name": "source",
      "type": "ExternalFrameSourceNode",
      "options": {
        "width": 1280,
        "height": 720,
        "fps": 30
      },
      "output_streams": ["output:frames"]
    },
    {
      "name": "encoder",
      "type": "VideoEncoderNode",
      "options": {
        "fps": 30,
        "bitrate": 4000000,
        "width": 1280,
        "height": 720,
        "gop_size": 1
      },
      "input_streams": ["input:frames"],
      "output_streams": ["output:es_packets"]
    },
    {
      "name": "recorder",
      "type": "RecorderNode",
      "input_streams": ["input:es_packets"],
      "output_streams": ["output:clips"]
    },
    {
      "name": "muxer",
      "type": "MuxerSinkNode",
      "options": {
        "output": "out/external_source.mp4",
        "width": 1280,
        "height": 720,
        "fps": 30
      },
      "input_streams": ["input:clips"]
    }
  ]
}
