<?xml version="1.0" encoding="utf-8"?>
<!-- 融合监测页（FACEP-018）：左信息面板 + 右预览区 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@android:color/black">

    <!-- ==================== 左侧信息面板 ==================== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#1A1A1A">

        <!-- 模块标题 -->
        <TextView
            android:id="@+id/tv_fusion_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fusion_title"
            android:textColor="#00FF00"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- ============ 人脸识别结果分区 ============ -->
        <TextView
            android:id="@+id/tv_panel_recognition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/fusion_panel_recognition"
            android:textColor="#00D0FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_rec_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/fusion_no_face"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_rec_confidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_rec_enrolled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <!-- ============ 疲劳检测结果分区 ============ -->
        <TextView
            android:id="@+id/tv_panel_fatigue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/fusion_panel_fatigue"
            android:textColor="#FFB300"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_fatigue_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_fatigue_eye"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_fatigue_mouth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <!-- ============ 分心监测（zone 提示） ============ -->
        <TextView
            android:id="@+id/tv_panel_distraction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/fusion_panel_distraction"
            android:textColor="#FF7043"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_distraction_zone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <!-- ============ 行为监测结果分区 ============ -->
        <TextView
            android:id="@+id/tv_panel_behavior"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/fusion_panel_behavior"
            android:textColor="#E040FB"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_behavior_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <!-- 返回按钮 -->
        <Button
            android:id="@+id/btn_back_home"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:minWidth="120dp"
            android:text="@string/btn_back_home"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ==================== 右侧预览区 ==================== -->
    <FrameLayout
        android:id="@+id/preview_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7">

        <!-- 预览 GLSurfaceView -->
        <android.opengl.GLSurfaceView
            android:id="@+id/preview_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 人脸框覆盖层（融合：68 点 + 头姿 + zone 面板） -->
        <com.skyworth.faceid.render.FaceOverlayView
            android:id="@+id/face_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
