<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:sharedUserId="android.uid.system"
    tools:ignore="Deprecated">
    <!-- 摄像头权限 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 外部存储读写权限（导出 dump 图像到 /sdcard） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- 网络：WebRTC 推流（http/https whip）与摄像头切换中继轮询 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 硬件特性声明 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- usesCleartextTraffic：targetSdk >= 28 起系统默认禁止明文 http。
         我们的推流地址（http://192.168.6.233:8889/test/whip）与切换中继
         （http://192.168.6.233:8081）都是明文 http，不放行会被系统直接拦掉。 -->
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.FaceIDPreview"
        android:usesCleartextTraffic="true">

        <!-- 主页（LAUNCHER，三入口） -->
        <activity
            android:name=".ui.HomeActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 人脸识别模块 -->
        <activity
            android:name=".ui.RecognitionActivity"
            android:exported="true"
            android:screenOrientation="landscape" />

        <!-- 人脸管理页（FACEP-012：GridView 批量删除） -->
        <activity
            android:name=".ui.FaceManageActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- 行为监测页（FACEP-017：阶段一只预览取流，后续加吸烟/打电话监测） -->
        <activity
            android:name=".ui.BehaviorMonitorActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- 融合监测页（FACEP-018：聚合识别/疲劳/分心/行为完整功能） -->
        <activity
            android:name=".ui.FusionMonitorActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- 推流测试校验页（media_record 录制/推流：CPU 与 surface 两条通路） -->
        <activity
            android:name=".ui.StreamTestActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- 疲劳监测模块 -->
        <activity
            android:name=".ui.FatigueActivity"
            android:exported="true"
            android:screenOrientation="landscape" />

        <!-- 分心监测模块 -->
        <activity
            android:name=".ui.DistractionActivity"
            android:exported="true"
            android:screenOrientation="landscape" />

        <!-- 现有功能页（三模块拆分前的过渡入口） -->
        <activity
            android:name=".ui.PreviewActivity"
            android:exported="true"
            android:screenOrientation="landscape" />

    </application>

</manifest>
