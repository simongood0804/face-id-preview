{
  "version": "1.0",
  "name": "faceid-pipeline",
  "description": "Phase 2 — uint8 Pipeline nodes + quantization adaptation (AdaptU8ToTf8)",
  "profile": {
    "enabled": "true",
    "output_path": "/data/logs",
    "modules": "infer"
  },
  "models": [
    {
      "id": "det_500m",
      "name": "Face Detection (SCRFD 0.5M)",
      "backend": "snpe",
      "model_path": "/vendor/etc/faceid/det_500m_int8.dlc",
      "load_strategy": "eager",
      "inputs": [
        {
          "name": "input.1",
          "shape": [1, 640, 640, 3],
          "layout": "NHWC",
          "pipeline": [
            {"name": "face::nearest_norm_u8", "params": {"height": "640", "width": "640"}}
          ]
        }
      ],
      "outputs": [
        {"name": "443", "shape": [12800, 1],  "dtype": "float32"},
        {"name": "468", "shape": [3200, 1],   "dtype": "float32"},
        {"name": "493", "shape": [800, 1],    "dtype": "float32"},
        {"name": "446", "shape": [12800, 4],  "dtype": "float32"},
        {"name": "471", "shape": [3200, 4],   "dtype": "float32"},
        {"name": "496", "shape": [800, 4],    "dtype": "float32"},
        {"name": "449", "shape": [12800, 10], "dtype": "float32"},
        {"name": "474", "shape": [3200, 10],  "dtype": "float32"},
        {"name": "499", "shape": [800, 10],   "dtype": "float32"}
      ],
      "config":
        {
          "num_threads": "2",
          "runtime": "dsp",
          "use_buffer": "true",
          "performance_profile": "high_performance"
        }
    },
    {
      "id": "face_antispoof",
      "name": "Face Anti-spoofing (Facenox)",
      "backend": "snpe",
      "model_path": "/vendor/etc/faceid/face_antispoof_int8.dlc",
      "load_strategy": "lazy",
      "inputs": [
        {
          "name": "input",
          "shape": [1, 128, 128, 3],
          "layout": "NHWC",
          "pipeline": [
            {"name": "face::nearest_norm_u8", "params": {"height": "128", "width": "128"}}
          ]
        }
      ],
      "outputs": [
        {
          "name": "output",
          "shape": [1, 2],
          "dtype": "float32",
          "pipeline": [
            {"name": "face::liveness_softmax"}
          ]
        }
      ],
      "config":
        {
          "num_threads": "2",
          "runtime": "dsp",
          "use_buffer": "true",
          "performance_profile": "high_performance"
        }
    },
    {
      "id": "2d106det",
      "name": "2D 106-point Landmark",
      "backend": "snpe",
      "model_path": "/vendor/etc/faceid/2d106det_int8.dlc",
      "load_strategy": "lazy",
      "inputs": [
        {
          "name": "data",
          "shape": [1, 192, 192, 3],
          "layout": "NHWC",
          "pipeline": [
            {"name": "face::affine_warp_u8", "params": {"output_size": "192", "transform": "from_bbox"}}
          ]
        }
      ],
      "outputs": [
        {
          "name": "fc1",
          "shape": [1, 212],
          "dtype": "float32",
          "pipeline": [
            {"name": "face::landmark_decode", "params": {"num_points": "106", "model_input_size": "192"}}
          ]
        }
      ],
      "config":
        {
          "num_threads": "2",
          "runtime": "dsp",
          "use_buffer": "true",
          "performance_profile": "high_performance"
        }
    },
    {
      "id": "w600k_mbf",
      "name": "Face Recognition (MobileFace 512-D)",
      "backend": "snpe",
      "model_path": "/vendor/etc/faceid/w600k_mbf_int8.dlc",
      "load_strategy": "lazy",
      "inputs": [
        {
          "name": "input.1",
          "shape": [1, 112, 112, 3],
          "layout": "NHWC",
          "pipeline": [
            {"name": "face::affine_warp_u8", "params": {"output_size": "112", "transform": "from_kps"}}
          ]
        }
      ],
      "outputs": [
        {
          "name": "516",
          "shape": [1, 512],
          "dtype": "float32",
          "pipeline": [
            {"name": "face::recog_decode", "params": {"dim": "512", "normalize": "true"}}
          ]
        }
      ],
      "config":
        {
          "num_threads": "2",
          "runtime": "dsp",
          "use_buffer": "true",
          "performance_profile": "high_performance"
        }
    },
    {
      "id": "hopenet_mbv2",
      "name": "Head Pose Estimation (MobileNetV2 + 6DRepNet)",
      "backend": "snpe",
      "model_path": "/vendor/etc/faceid/hopenet_mbv2_int8.dlc",
      "load_strategy": "lazy",
      "inputs": [
        {
          "name": "data",
          "shape": [1, 224, 224, 3],
          "dtype": "float32",
          "layout": "NHWC",
          "pipeline": [
            {"name": "face::affine_warp", "params": {"output_size": "224", "transform": "from_bbox", "normalize": "false", "nchw": "false"}}
          ]
        }
      ],
      "outputs": [
        {
          "name": "pose_6d",
          "shape": [1, 6],
          "dtype": "float32",
          "pipeline": [
            {"name": "face::headpose_decode"}
          ]
        }
      ],
      "config":
        {
          "num_threads": "2",
          "runtime": "dsp",
          "use_buffer": "true",
          "performance_profile": "high_performance"
        }
    }
  ]
}
