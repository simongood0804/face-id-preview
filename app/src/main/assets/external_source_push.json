{
  "nodes": [
    {
      "name": "source",
      "type": "ExternalFrameSourceNode",
      "options": {
        "width": 1280,
        "height": 720,
        "fps": 30
      },
      "output_streams": ["output:frames"]
    },
    {
      "name": "encoder",
      "type": "VideoEncoderNode",
      "options": {
        "fps": 30,
        "bitrate": 1000000,
        "width": 1280,
        "height": 720,
        "gop_size": 1
      },
      "input_streams": ["input:frames"],
      "output_streams": ["output:es_packets"]
    },
    {
      "name": "push",
      "type": "StreamPushNode",
      "options": {
        "backend_type": "webrtc",
        "remote_url": "http://${PUSH_HOST}:8889/test/whip",
        "video_codec": "h264",
        "audio_codec": "aac",
        "initial_bitrate_kbps": 800,
        "max_bitrate_kbps": 1200,
        "min_bitrate_kbps": 200,
        "resolution_width": 1280,
        "resolution_height": 720,
        "framerate": 30,
        "buffer_duration_s": 30,
        "reconnect_max_interval_s": 30
      },
      "input_streams": ["input:es_packets"]
    }
  ]
}
