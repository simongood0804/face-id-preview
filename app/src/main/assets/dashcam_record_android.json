{
  "nodes": [
    {
      "name": "render",
      "type": "DashcamRenderNode",
      "options": {
        "background": "/data/local/tmp/media_record/src/examples/assets/dashcam_road.png",
        "car": "/data/local/tmp/media_record/src/examples/assets/flydog.png",
        "font": "/data/local/tmp/media_record/src/examples/assets/Roboto-Regular.ttf",
        "width": 1280,
        "height": 720,
        "fps": 30,
        "frame_count": 300,
        "format": "%Y-%m-%d %H:%M:%S",
        "input_surface": true
      },
      "output_streams": ["output:frames"]
    },
    {
      "name": "encoder",
      "type": "VideoEncoderNode",
      "options": {
        "fps": 30,
        "bitrate": 4000000,
        "input_surface": true,
        "width": 1280,
        "height": 720,
        "gop_size": 1
      },
      "input_streams": ["input:frames"],
      "output_streams": ["output:es_packets"]
    },
    {
      "name": "recorder",
      "type": "RecorderNode",
      "input_streams": ["input:es_packets"],
      "output_streams": ["output:clips"]
    },
    {
      "name": "muxer",
      "type": "MuxerSinkNode",
      "options": {
        "output": "/data/local/tmp/media_record/out/dashcam.mp4",
        "width": 1280,
        "height": 720,
        "fps": 30
      },
      "input_streams": ["input:clips"]
    }
  ]
}
